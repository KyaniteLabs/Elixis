    },
    {
      "pattern": ".cursorrules",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": ".dockerignore",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": ".env.example",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": ".fl4write.yaml",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": ".gitignore",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": ".windsurfrules",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "AGENTS.md",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "CHANGELOG.md",
      "layer": "product-documentation",
      "owner": "product"
    },
    {
      "pattern": "CLAUDE.md",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "CONTEXT.md",
      "layer": "product-documentation",
      "owner": "product"
    },
    {
      "pattern": "CONTRIBUTING.md",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "DEPLOY.md",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "Dockerfile",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "LICENSE",
      "layer": "product-documentation",
      "owner": "product"
    },
    {
      "pattern": "README.md",
      "layer": "product-documentation",
      "owner": "product"
    },
    {

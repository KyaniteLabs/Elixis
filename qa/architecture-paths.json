      "owner": "engineering"
    },
    {
      "pattern": ".github/**",
      "layer": "github-automation",
      "owner": "engineering"
    },
    {
      "pattern": ".forgejo/**",
      "layer": "mirror-automation",
      "owner": "engineering"
    },
    {
      "pattern": "qa/**",
      "layer": "architecture-and-foundations",
      "owner": "engineering"
    },
    {
      "pattern": "docs/**",
      "layer": "public-documentation",
      "owner": "product"
    },
    {

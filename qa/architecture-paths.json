    {
      "pattern": "docker-compose.yml",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "llms-full.txt",
      "layer": "product-documentation",
      "owner": "product"
    },
    {
      "pattern": "llms.txt",
      "layer": "product-documentation",
      "owner": "product"
    },
    {
      "pattern": "openapi.yaml",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "pyproject.toml",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "renovate.json",
      "layer": "application-and-configuration",
      "owner": "engineering"
    },
    {
      "pattern": "requirements.txt",
      "layer": "application-and-configuration",

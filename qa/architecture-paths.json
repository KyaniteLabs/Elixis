{
  "schema_version": 1,
  "repo": "github.com/KyaniteLabs/Elixis",
  "paths": [
    {
      "pattern": "PRODUCT.md",
      "layer": "product-documentation",
      "owner": "product"
    },
    {
      "pattern": "elixis/**",
      "layer": "synthesis-runtime",
      "owner": "engineering"
    },
    {
